# Names only. The app does not load this file. Export variables in the terminal.
# Never commit a real API key, OAuth secret, or session secret.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Claude for organizing + Ask (takes priority over OpenAI for those two).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# local | beta | production
LIFE_INBOX_ENV=local
DATABASE_URL=sqlite:///data/life_inbox.db
# Deploy: postgresql://USER:PASS@HOST:5432/life_inbox

LIFE_INBOX_UPLOAD_DIR=
# Required ≥32 private random chars in beta/production (SESSION_SECRET alias accepted).
# Startup rejects missing/short values and the published local default secret.
LIFE_INBOX_SESSION_SECRET=
# SESSION_SECRET=

# Passwordless local sign-in. Forced OFF outside LIFE_INBOX_ENV=local.
LIFE_INBOX_ALLOW_DEV_LOGIN=1

# local | google
LIFE_INBOX_AUTH_MODE=local

# Public HTTPS origin of the deployed app (no trailing slash required)
LIFE_INBOX_PUBLIC_BASE_URL=
# e.g. https://life-inbox-demo.onrender.com

# Google OAuth (any Google account; no domain restriction)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override; otherwise derived as:
#   {LIFE_INBOX_PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=
